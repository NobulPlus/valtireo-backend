---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import CallToAction from '../components/CallToAction.astro';
import { modules, faqs, demoUrl, flagshipModuleIds, industries } from '../data/site';
const flagshipModules = flagshipModuleIds.map(id => modules.find(m => m.id === id)!);
const otherModules = modules.filter(m => !flagshipModuleIds.includes(m.id));
---
<SiteLayout>
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><i></i> THE ORGANIZATIONAL OS</span><h1>Your organization.<br/>Working <em>as one.</em></h1><p>Bring your people, processes, and everyday decisions into one connected workspace. Less scattered work. More clarity to move forward.</p><div class="hero-actions"><a class="button button-lime" href={demoUrl || '/contact/'}>Explore Valtireo with us <Icon size={19}/></a><a class="text-link" href="/product/">Meet the platform <span>↗</span></a></div><div class="hero-note"><span class="little-check">✓</span> Built around your structure. Ready for your people.</div></div><div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hero-star" aria-hidden="true">✳</div><div class="floating-note"><span class="note-icon"><Icon name="check" size={20}/></span><div><strong>A clear next step.</strong><small>Request approved · Owner notified</small></div></div><AppScreenshot compact eager src="/images/app/dashboard.png" alt="Valtireo dashboard overview"/><div class="connected-note"><span class="connected-dots"><b>HR</b><b>IT</b><b>OP</b></span><span>Different teams.<br/><strong>One connected organization.</strong></span></div></div></div><div class="hero-bottom container"><span>ONE WORKSPACE. A SHARED WAY FORWARD.</span><div>People <i>✳</i> Workflows <i>✳</i> Payroll <i>✳</i> Documents <i>✳</i> Internal services</div></div></section>
  <section class="intro-section container"><span class="eyebrow">MAKE ROOM FOR BETTER WORK</span><h2>Running an organization is complex.<br/><span>Your tools shouldn’t add to it.</span></h2><p>Employee details in one place. Requests in another. Important documents buried in a message thread. Valtireo brings the pieces together, so your team can focus on the work that matters.</p></section>
  <section class="container people-section"><div class="people-grid"><img src="/images/stock/team-organization.jpg" alt="A team meeting together inside an organization" class="people-photo"/><div><span class="eyebrow">BUILT FOR REAL ORGANIZATIONS</span><h2>An organization.<br/>A process.<br/>A person behind every step.</h2><p>Behind every request, approval, and record is someone doing real work — an employee waiting on a decision, a manager closing out the week, an administrator keeping the structure sound. Valtireo is built around all three at once, not just the org chart.</p></div></div></section>
  <section class="platform-section" id="platform"><div class="container"><div class="section-heading"><div><span class="eyebrow">CONNECTED BY DESIGN</span><h2>A place for every person.<br/>A path for every process.</h2></div><a class="text-link dark-link" href="/product/">Explore the platform <Icon size={20}/></a></div><div class="feature-grid">{flagshipModules.map((module, index) => <a data-reveal class:list={['feature-card', `feature-${index}`]} href={`/product/#${module.id}`}><div class="feature-card-top"><span class="feature-icon"><Icon name={module.icon} size={27}/></span><span class="feature-arrow">↗</span></div><span class="feature-number">{module.number} / THE PLATFORM</span><h3>{module.title}</h3><p>{module.description}</p><div class="feature-tags">{module.tags.slice(0,2).map(tag => <span>{tag}</span>)}</div></a>)}</div><div class="module-strip">{otherModules.map(module => <a href={`/product/#${module.id}`}><Icon name={module.icon} size={22}/>{module.title}<span>↗</span></a>)}</div></div></section>
  <section class="workspace-section container"><div class="center-heading"><span class="eyebrow">THE BIG PICTURE. THE EVERYDAY DETAILS.</span><h2>Get everyone on the same page.</h2><p>Give administrators oversight, managers context, and employees a clear place to get things done.</p></div><div class="workspace-frame"><div class="workspace-label"><span><i></i> A connected workspace</span><span>Real product screenshot</span></div><AppScreenshot src="/images/app/dashboard.png" alt="Valtireo dashboard overview"/></div><div class="benefit-row"><div data-reveal><Icon name="people"/><h3>Built around your structure</h3><p>Departments, reporting lines, roles, and permissions that reflect how you work.</p></div><div data-reveal><Icon name="workflow"/><h3>Clear ownership at every step</h3><p>Know where requests stand and keep a record of the decisions behind them.</p></div><div data-reveal><Icon name="shield"/><h3>The right view for each role</h3><p>Help people access the information and actions relevant to their responsibilities.</p></div></div></section>
  <section class="solutions-section" id="solutions"><div class="container solutions-grid"><div><span class="eyebrow">YOUR ORGANIZATION ISN’T ONE-SIZE-FITS-ALL</span><h2>Neither is the way<br/>you work.</h2><p>From growing businesses to established institutions, good work needs structure. Configure your workspace around your people, policies, and processes.</p><a class="button button-dark" href="/about/">Our approach <Icon size={18}/></a></div><div class="industry-list">{industries.map((industry, index) => <a data-reveal href={`/industries/${industry.slug}/`}><span>{String(index+1).padStart(2,'0')}</span><div><h3>{industry.title}</h3><p>{industry.description}</p></div><Icon name="arrow" size={22}/></a>)}</div></div></section>
  <section class="steps-section container"><div class="section-heading"><div><span class="eyebrow">START WITH YOUR REAL WORLD</span><h2>A thoughtful path<br/>to a connected organization.</h2></div><p>We start with how your organization works,<br/>then make space for a better way.</p></div><div class="steps-grid">{[['01','Understand your organization','Map your teams, existing processes, and what you need to make clearer.'],['02','Shape your workspace','Set up the structure, modules, roles, and workflows that fit your needs.'],['03','Bring your people together','Introduce the workspace to your team and build a shared working rhythm.']].map(([n,title,desc]) => <div data-reveal><span>{n}</span><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
  <section class="faq-section container" id="faq"><div><span class="eyebrow">A LITTLE MORE CLARITY</span><h2>Good questions.<br/>Straight answers.</h2><p>Getting to know Valtireo?<br/>Here’s a helpful place to start.</p><a class="text-link dark-link" href="/faq/">See all FAQs <Icon size={18}/></a></div><div class="faq-list">{faqs.map(([q,a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <CallToAction/>
</SiteLayout>
