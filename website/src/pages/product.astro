---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import CallToAction from '../components/CallToAction.astro';
import { modules, platformServices } from '../data/site';
---
<SiteLayout title="The platform — Valtireo"><section class="page-hero container"><span class="eyebrow">ONE ORGANIZATION. ONE CONNECTED WORKSPACE.</span><h1>From everyday tasks<br/>to a <em>clearer picture.</em></h1><p>People operations are the starting point. Valtireo connects the surrounding work—documents, decisions, services, and oversight.</p><div class="page-module-nav">{modules.map(m => <a href={`#${m.id}`}>{m.title} ↘</a>)}</div></section><section class="container product-full"><AppScreenshot src="/images/app/dashboard.png" alt="Valtireo dashboard overview"/></section><div class="container module-details">{modules.map(module => <section id={module.id} data-reveal class="module-detail"><div><span class="eyebrow">{module.number} / {module.title}</span><h2>{module.short}</h2></div><div><p>{module.description}</p><ul>{module.tags.map(tag => <li><Icon name="check" size={19}/>{tag}</li>)}</ul><a class="text-link dark-link" href={`/product/${module.id}/`}>Read more about {module.title} <Icon size={18}/></a></div></section>)}</div><section class="steps-section container"><div class="center-heading"><span class="eyebrow">UNDER EVERY MODULE</span><h2>One connected platform.</h2><p>Shared services every module builds on, instead of each one reinventing its own.</p></div><div class="benefit-row">{platformServices.map(service => <div data-reveal><Icon name={service.icon} size={28}/><h3>{service.title}</h3><p>{service.description}</p></div>)}</div></section><CallToAction/></SiteLayout>
