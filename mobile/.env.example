# The Laravel dev server. "localhost" does NOT resolve from a physical
# device or the Android emulator — only from the iOS simulator.
#
# Recommended: install Tailscale on both the laptop and the phone (same
# account), then use the laptop's Tailscale IP (`tailscale ip -4`). This
# stays fixed and reachable from any network — home, office, cellular —
# so you never have to re-check or reconfigure it when you change Wi-Fi.
# EXPO_PUBLIC_API_BASE_URL=http://100.x.y.z:8000/api
#
# Otherwise, physical device (phone and computer on the same Wi-Fi): use the
# computer's LAN IP, e.g. http://192.168.1.42:8000/api
#
# Android emulator: use the special loopback alias:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# iOS simulator can use:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
